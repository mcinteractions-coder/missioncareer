# =========================================================================
# Mission Career — Environment Variables Reference
# =========================================================================
# On Lovable, these are auto-provisioned. Copy this file to `.env` only when
# you migrate the project to your own hosting (Vercel, Cloudflare, Netlify,
# self-hosted, etc.). See MIGRATION.md for full instructions.

# --- Supabase (database, auth, storage) ---------------------------------
# Public (safe to expose to browser)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Server-only (NEVER expose to browser)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # bypasses RLS — keep secret

# --- AI provider for ChatBot (pick ONE) ---------------------------------
# Priority order: OPENAI_API_KEY > GEMINI_API_KEY > LOVABLE_API_KEY
# On Lovable: leave only LOVABLE_API_KEY (auto-set).
# Off Lovable: set OPENAI_API_KEY or GEMINI_API_KEY and remove LOVABLE_API_KEY.

# Option A — OpenAI
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"   # optional, default shown

# Option B — Google Gemini
# GEMINI_API_KEY="..."
# GEMINI_MODEL="gemini-2.0-flash"   # optional, default shown

# Option C — Lovable AI Gateway (only works on Lovable hosting)
# LOVABLE_API_KEY="auto-provisioned-by-lovable"
